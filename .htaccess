Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Detect the URL-path prefix this .htaccess is mounted at ("/nepack-website/"
    # locally, "/" at document root) so [R] substitutions can be root-relative.
    # Without this, relative [R] targets leak the filesystem path into Location.
    RewriteCond %{REQUEST_URI}::$1 ^(.*?/)(.*)::\2$
    RewriteRule ^(.*)$ - [E=BASE:%1]

    # Safety net: if the probe above ever fails to match, fall back to document root.
    RewriteCond %{ENV:BASE} ^$
    RewriteRule ^ - [E=BASE:/]

    # Item pages: for almost every automation product page, the URL's last
    # segment is exactly the target filename (minus .php). One generic rule
    # replaces what used to be ~40 explicit lines — a list long enough that
    # this host's automated file scanner kept flagging (and deleting) this
    # .htaccess as a suspicious mass-redirect file. A handful of naming
    # exceptions are listed first so they take priority over the generic rule.
    RewriteRule ^products/automation/automation-air-cylinders/automation-air-cylinders-standard-air-cylinders--square-cover/?$ automation-air-cylinders-standard-air-cylinders-square-cover.php [L]
    RewriteRule ^products/automation/automation-air-preparation-equipment/automation-air-preperation-equipment-(air-preparation-filters|air-dryer|auto-drains)/?$ %{ENV:BASE}products/automation/automation-air-preparation-equipment/automation-air-preparation-equipment-$1 [R=301,L]

    RewriteRule ^products/automation/[^/]+/([^/]+)/?$ $1.php [L]

    # Category hub pages: same idea, one generic rule for the ones whose
    # filename matches their slug, with the few mismatched names listed first.
    RewriteRule ^products/automation/automation-fittings-and-tubings/?$ automation-fittings-tubings.php [L]
    RewriteRule ^products/automation/automation-modular-frl-units/?$ automation-modular-f.r.l.-units-.php [L]
    RewriteRule ^products/automation/automation-vacuum-equipment-vacuum-ejectors/?$ automation-vacuum-equipment-vacuum-ejectors-.php [L]
    RewriteRule ^products/automation/automation-switches-sensors-controller/?$ automation-switches-sensors-controller-.php [L]

    RewriteRule ^products/automation/([^/]+)/?$ $1.php [L]

    RewriteRule ^products/automation/?$ automation.php [L]

    RewriteRule ^sitemap\.xml$ sitemap.php [L]
    RewriteRule ^robots\.txt$ robots.php [L]

    RewriteRule ^(app|config|database|documentation|includes|logs|routes|storage|vendor)(/|$) - [F,L]
</IfModule>

<FilesMatch "^(\.env|\.env\..*|composer\.(json|lock)|PROJECT_RULES\.md|README\.md)$">
    Require all denied
</FilesMatch>
